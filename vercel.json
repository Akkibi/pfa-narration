{
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
            "source": "/(.*)\\.(glb|webp|opus|webm|mp4|woff2?|ttf|otf|jpg|png|wasm)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800, stale-while-revalidate=2592000"
                }
            ]
        }
    ]
}
